# build artifacts (regenerate: cargo build / cargo run --release -- build)
target/
# regenerable database (cargo run --release -- inject)
qubitick.db
*.olean
*.ilean
.lake/
node_modules/
qubitick.db-shm
qubitick.db-wal
qubitick.db-journal

# web-next dev
test-results/
playwright-report/
tests/ui/shots/**/*.diff.png
# web-next/vendor is RUNTIME, not build output: the page loads these four files from /vendor
# (js/app/math.js:34 KaTeX's classic-script build + its stylesheet, js/live/editor.js:13
# CodeMirror as ESM, js/live/graph.js:31 dagre). Ignoring the directory shipped an app whose
# every formula fell back to raw source with no error anywhere, because a checkout — or a
# server — that had never run `yarn vendor` had no library to load. The four files are
# deliverables now (tests/unit/vendor-assets.test.mjs holds the line); anything else that
# turns up in the directory stays ignored.
web-next/vendor/*
!web-next/vendor/.gitkeep
!web-next/vendor/katex.min.js
!web-next/vendor/katex.min.css
!web-next/vendor/cm.bundle.js
!web-next/vendor/dagre.min.js

# npm scratch: install caches and offline tarballs, never part of the app
.npm/
.npm-cache/
esbuild-*.tgz

# dev wrapper toolchain shim (machine-local nix store path, regenerated by ./dev)
.devbin/

# local Rust toolchain provisioned by ./toolchain when the flake devShell is unusable
.cargo/
.rustup/

# corpus triage scratch
.triage_build.json

# local scratch: harness scripts and review screenshots, never part of the app
.scratch/

# agent-session state written by the harness, not by this project
.jspace/

# the Lake package a corpus is emitted into (regenerable cache)
project/.lake/

# runtime: per-corpus web UI settings written by /api/settings
web-settings.json
